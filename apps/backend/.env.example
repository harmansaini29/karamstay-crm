# ==============================================================================
# KaramStay Backend Production Environment Configuration
# ==============================================================================

# Application environment
ENVIRONMENT=production
APP_NAME=KaramStay

# PostgreSQL Database Connection (AWS RDS or Supabase)
# Format: postgresql+psycopg://<username>:<password>@<rds-endpoint>:5432/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password@karamstay-db.cxxxxxx.ap-south-1.rds.amazonaws.com:5432/karamstay_prod

# Cryptographic JWT Secret Key (Generate via: openssl rand -hex 32)
JWT_SECRET_KEY=generate-a-strong-random-32-byte-hex-string-for-jwt-signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins (Must be a valid JSON list of allowed web frontend URLs)
BACKEND_CORS_ORIGINS=["https://app.karamstay.com","https://admin.karamstay.com"]

# Rate Limiting Guard
RATE_LIMIT_ENABLED=true

# AWS S3 Cloud Object Storage (KYC Documents, Lease Agreements, Photos)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=karamstay-production-vault
# Note: If running on AWS ECS Fargate with an IAM Task Role, leave ACCESS_KEY empty.
# If using static IAM user credentials, fill them in:
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_PRESIGNED_URL_EXPIRE_SECONDS=3600

# WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
WHATSAPP_CLOUD_API_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0

# Firebase Cloud Messaging (FCM for push notifications)
# Option A: Path to service account file mounted on container
FIREBASE_SERVICE_ACCOUNT_FILE=/app/firebase-service-account.json
# Option B: Inline JSON string (useful in cloud secret managers)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Firebase Cloud Messaging (service account JSON, either inline or a file path)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=

# Tenant OTP Login Settings
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# Billing & Invoicing Automation
LATE_FEE_GRACE_DAYS=3
LATE_FEE_PERCENT_PER_DAY=1.0
INVOICE_GENERATION_DAY=1