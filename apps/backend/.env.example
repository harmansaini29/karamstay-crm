# ==============================================================================
# KaramStay Backend Production Environment Configuration
# ==============================================================================

# Application environment: production / staging / local
ENVIRONMENT=production
APP_NAME=KaramStay

# PostgreSQL Database Connection (AWS RDS or Supabase)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password@karamstay-db.cxxxxxx.ap-south-1.rds.amazonaws.com:5432/karamstay_prod

# Cryptographic JWT Secret Key (Generate via: openssl rand -hex 32)
JWT_SECRET_KEY=generate-a-strong-random-32-byte-hex-string-for-jwt-signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting Guard
RATE_LIMIT_ENABLED=true

# AWS S3 Cloud Object Storage (KYC Documents, Lease Agreements, Photos)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=karamstay-production-vault
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_PRESIGNED_URL_EXPIRE_SECONDS=3600

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["https://app.karamstay.com","https://admin.karamstay.com"]

# Optional External Notifications (FCM & WhatsApp Cloud API)
# FIREBASE_SERVICE_ACCOUNT_FILE=/app/firebase-service-account.json
# WHATSAPP_ACCESS_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=100000000000000
