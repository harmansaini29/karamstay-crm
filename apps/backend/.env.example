APP_NAME=KaramStay
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://karamstay:change-me@localhost:5432/karamstay
JWT_SECRET_KEY=change-this-in-secrets-manager-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
BACKEND_CORS_ORIGINS=[]

# WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0

# Firebase Cloud Messaging (service account JSON, either inline or a file path)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=

# AWS S3 (Legal Vault document storage)
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGNED_URL_EXPIRE_SECONDS=300

# Rate limiting
RATE_LIMIT_ENABLED=true

# OTP (tenant login)
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# Billing (overridable later via the Settings module)
LATE_FEE_GRACE_DAYS=3
LATE_FEE_PERCENT_PER_DAY=1.0
INVOICE_GENERATION_DAY=1
